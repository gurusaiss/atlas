# === Atlas Backend Environment Variables ===
# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string-before-any-real-deployment
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Local docker-compose overrides this to point at the postgres service.
DATABASE_URL=postgresql+asyncpg://atlas:atlas_dev_password@localhost:5432/atlas

# --- Redis (cache + Celery broker) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Providers (free tiers) ---
# Gemini 1.5 Flash - https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq - https://console.groq.com/keys
GROQ_API_KEY=
# Mistral (Codestral) - https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Ollama fallback (fully offline, no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# --- Token budget ---
DEFAULT_TOKEN_BUDGET=50000

# --- ChromaDB (in-process, stored on disk) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50
UPLOAD_TMP_DIR=./tmp_uploads

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_METRICS_ENABLED=true
