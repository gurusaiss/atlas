{
  "title": "Atlas -- Agentic Legacy Modernization",
  "uid": "atlas-main",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Jobs per hour",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(atlas_jobs_total[1h])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 2,
      "title": "Agent success rate by type",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(atlas_agent_duration_seconds_count[1h])) by (agent_type)",
          "legendFormat": "{{agent_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Token consumption by model",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(increase(atlas_llm_tokens_total[1h])) by (model)", "legendFormat": "{{model}}" }
      ]
    },
    {
      "id": 4,
      "title": "Guardrail rejection rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(atlas_guardrail_events_total{action=\"blocked\"}[15m])) by (type)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Average analysis time by repo size",
      "type": "scatter",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "atlas_job_duration_seconds_sum / atlas_job_duration_seconds_count",
          "legendFormat": "avg duration (s)"
        }
      ]
    },
    {
      "id": 6,
      "title": "Finding severity distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(atlas_findings_total) by (severity)", "legendFormat": "{{severity}}" }
      ]
    },
    {
      "id": 7,
      "title": "API latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 8,
      "title": "Active jobs",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "targets": [{ "expr": "atlas_active_jobs" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 20 } }
    },
    {
      "id": 9,
      "title": "LLM cache hit rate",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum(rate(atlas_llm_cache_hits_total[1h])) / sum(rate(atlas_llm_requests_total[1h]))",
          "legendFormat": "cache hit rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.4 },
              { "color": "green", "value": 0.6 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Rate limit events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 32 },
      "targets": [
        { "expr": "sum(rate(atlas_rate_limit_hits_total[15m])) by (model)", "legendFormat": "{{model}}" }
      ]
    }
  ]
}
